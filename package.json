{
  "name": "yuri-choi-cv",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/generate-notes-pages.mjs && vinext dev",
    "build": "node scripts/generate-notes-pages.mjs && vinext build",
    "start": "vinext start",
    "test": "node --test tests/rendered-html.test.mjs tests/approved-revision.test.mjs tests/career-summary.test.mjs tests/company-archives.test.mjs tests/cv-access.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --incremental false",
    "check:release": "pnpm run typecheck && pnpm run build && pnpm test",
    "types:worker": "wrangler types types/cloudflare-runtime.d.ts --config dist/server/wrangler.json --include-env false",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "1.95.1",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "linkedom": "0.18.12",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
