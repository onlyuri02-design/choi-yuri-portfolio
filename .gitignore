# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars*
/.pnpm-store/

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# Local rollback snapshots, not Site source or public assets
/app-before-full-restore-20260913/
/dist-before-contact-20260913/
/dist-before-cover-20260913/
/dist-before-final-metrics-20260916/
/dist-before-full-restore-20260913/
/.sites-runtime/
/.preview-temp/
*.tsbuildinfo

# Private/local migration exclusions
/.tmp/
/tmp/
/drafts/
/docs/page-counts.md
*.log
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
